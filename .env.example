# =============================================================================
# ElecSarthi Backend - Production Environment Variables Example
# Copy this file to .env and replace all placeholders with strong random values.
# NEVER commit .env to source control!
# =============================================================================

# --- Database Configuration (PostgreSQL 18) ---
POSTGRES_DB=elecsarthi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_postgres_admin_password
POSTGRES_PORT=5432

# Unprivileged Runtime User for the Backend (created in V2 migration)
DB_USER=elecsarthi_app
DB_PASSWORD=replace_with_strong_elecsarthi_app_password

# --- Backend Application Configuration ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
MOBILE_NUMBERS_ENABLED=false

# --- Cryptographic Material (MUST BE GENERATED SECURELY) ---

# JWT Secret: 256-bit key in Hex (64 hex characters)
# Generate via: openssl rand -hex 32
ELECSARTHI_JWT_SECRET=replace_with_64_hex_chars_jwt_secret_0123456789abcdef0123456789abcdef

# Activation Pepper: HMAC pepper for Crockford Base32 customer codes (min 16 chars)
# Generate via: openssl rand -base64 24
ELECSARTHI_SECURITY_ACTIVATION_PEPPER=replace_with_strong_activation_pepper_string_2026

# Ed25519 Private Key for Offline Booth Lease Signing: 32-byte seed in Hex (64 hex characters)
# Generate via: openssl rand -hex 32
ELECSARTHI_SECURITY_ED25519_PRIVATE_KEY_HEX=replace_with_64_hex_chars_ed25519_private_key_0123456789abcdef012345
ELECSARTHI_SECURITY_ED25519_KEY_VERSION=1

# Voter Mobile AES-256-GCM Key: 256-bit encryption key in Hex (64 hex characters)
# Generate via: openssl rand -hex 32
ELECSARTHI_SECURITY_VOTER_MOBILE_AES_KEY_HEX=replace_with_64_hex_chars_aes_256_key_0123456789abcdef0123456789ab
ELECSARTHI_SECURITY_VOTER_MOBILE_KEY_VERSION=1
