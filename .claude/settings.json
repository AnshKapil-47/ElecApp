{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(./gradlew *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(flutter pub get *)",
      "Bash(dart format *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(tools/db/run_tests.sh *)",
      "Bash(python3 tools/seed/gen_seed.py *)",
      "Bash(python3 tools/erd/gen_erd.py *)",
      "Bash(python3 tools/erd/verify_ends.py *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(psql *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/secrets/**)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/*.jks)",
      "Read(/**/*.p12)",
      "Bash(flyway clean *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_files.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
